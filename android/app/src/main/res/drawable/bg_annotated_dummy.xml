<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base "captured photo" placeholder -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/drishti_blue_100" />
            <corners android:radius="14dp" />
        </shape>
    </item>

    <!-- Simulated AI bounding boxes around detected lesions -->
    <item android:width="48dp" android:height="34dp" android:gravity="top|start" android:top="28dp" android:left="36dp">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="@color/status_moderate" />
            <corners android:radius="4dp" />
        </shape>
    </item>

    <item android:width="34dp" android:height="28dp" android:gravity="bottom|end" android:bottom="34dp" android:right="30dp">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="@color/status_severe" />
            <corners android:radius="4dp" />
        </shape>
    </item>

    <item android:width="26dp" android:height="22dp" android:gravity="bottom|start" android:bottom="66dp" android:left="66dp">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="@color/status_mild" />
            <corners android:radius="4dp" />
        </shape>
    </item>
</layer-list>
