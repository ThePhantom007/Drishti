<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Drishti" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/drishti_blue_800</item>
        <item name="colorPrimaryVariant">@color/drishti_blue_900</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/drishti_blue_500</item>
        <item name="colorSecondaryVariant">@color/drishti_blue_700</item>
        <item name="colorOnSecondary">@color/on_primary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorError">@color/status_severe</item>
        <item name="android:statusBarColor">@color/drishti_blue_900</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="materialButtonStyle">@style/Widget.Drishti.Button</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Theme.Drishti.NoBar">
        <item name="android:statusBarColor">@android:color/black</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.Drishti.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.Drishti.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="strokeColor">@color/drishti_blue_800</item>
        <item name="android:textColor">@color/drishti_blue_800</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Widget.Drishti.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/drishti_blue_800</item>
    </style>

    <!-- Toolbar -->
    <style name="Widget.Drishti.Toolbar" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="android:background">@color/drishti_blue_800</item>
        <item name="titleTextColor">@color/white</item>
        <item name="android:elevation">2dp</item>
    </style>

    <!-- Card -->
    <style name="Widget.Drishti.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">6dp</item>
        <item name="cardBackgroundColor">@color/glass_panel</item>
        <item name="strokeColor">@color/glass_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Text input -->
    <style name="Widget.Drishti.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/white</item>
        <item name="boxBackgroundColor">@color/glass_panel_soft</item>
        <item name="hintTextColor">@color/drishti_blue_900</item>
        <item name="android:textColorHint">@color/text_secondary</item>
    </style>

    <!-- Text input: exposed dropdown menu variant (sex, preferred language) -->
    <style name="Widget.Drishti.TextInputLayout.ExposedDropdownMenu" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/white</item>
        <item name="boxBackgroundColor">@color/glass_panel_soft</item>
        <item name="hintTextColor">@color/drishti_blue_900</item>
        <item name="android:textColorHint">@color/text_secondary</item>
    </style>

    <!-- Chip -->
    <style name="Widget.Drishti.Chip" parent="Widget.MaterialComponents.Chip.Action">
        <item name="chipBackgroundColor">@color/drishti_blue_050</item>
        <item name="android:textColor">@color/drishti_blue_900</item>
        <item name="chipStrokeWidth">0dp</item>
    </style>

    <!-- Text styles -->
    <style name="TextAppearance.Drishti.Headline" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Drishti.Title" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Drishti.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Drishti.Caption" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/text_secondary</item>
    </style>
</resources>
