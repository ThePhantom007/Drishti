<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/glass_panel"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/glass_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dateText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Drishti.Title"
                android:textSize="14sp"
                tools:text="2 Sep 2026 · Right Eye (OD)" />

            <TextView
                android:id="@+id/lesionSummaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.Drishti.Caption"
                tools:text="14 microaneurysms, 3 hemorrhages" />
        </LinearLayout>

        <TextView
            android:id="@+id/gradeChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_moderate"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textColor="@color/status_moderate"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Moderate NPDR" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
