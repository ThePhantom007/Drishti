<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.veyronix.drishti.ui.login.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">

        <action
            android:id="@+id/action_login_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.veyronix.drishti.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_home_to_registration"
            app:destination="@id/patientRegistrationFragment" />
        <action
            android:id="@+id/action_home_to_history"
            app:destination="@id/patientHistoryFragment" />
        <action
            android:id="@+id/action_home_to_syncQueue"
            app:destination="@id/syncQueueFragment" />
        <action
            android:id="@+id/action_home_to_settings"
            app:destination="@id/settingsFragment" />
    </fragment>

    <fragment
        android:id="@+id/patientRegistrationFragment"
        android:name="com.veyronix.drishti.ui.registration.PatientRegistrationFragment"
        android:label="New Patient"
        tools:layout="@layout/fragment_patient_registration">

        <action
            android:id="@+id/action_registration_to_capture"
            app:destination="@id/captureFragment" />
        <action
            android:id="@+id/action_registration_to_processing"
            app:destination="@id/processingFragment" />
    </fragment>

    <fragment
        android:id="@+id/captureFragment"
        android:name="com.veyronix.drishti.ui.capture.CaptureFragment"
        android:label="Capture"
        tools:layout="@layout/fragment_capture">

        <argument
            android:name="patientId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="eye"
            android:defaultValue="OD"
            app:argType="string" />

        <action
            android:id="@+id/action_capture_to_processing"
            app:destination="@id/processingFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/processingFragment"
        android:name="com.veyronix.drishti.ui.processing.ProcessingFragment"
        android:label="Processing"
        tools:layout="@layout/fragment_processing">

        <!-- Backend returns either a graded or rejected result -->
        <action
            android:id="@+id/action_processing_to_resultGraded"
            app:destination="@id/resultGradedFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="false" />
        <action
            android:id="@+id/action_processing_to_resultRejected"
            app:destination="@id/resultRejectedFragment"
            app:popUpTo="@id/captureFragment"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/resultRejectedFragment"
        android:name="com.veyronix.drishti.ui.result.ResultRejectedFragment"
        android:label="Retake Needed"
        tools:layout="@layout/fragment_result_rejected">

        <argument
            android:name="recaptureMessage"
            app:argType="string" />

        <action
            android:id="@+id/action_rejected_to_capture"
            app:destination="@id/captureFragment"
            app:popUpTo="@id/captureFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_rejected_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/resultGradedFragment"
        android:name="com.veyronix.drishti.ui.result.ResultGradedFragment"
        android:label="Result"
        tools:layout="@layout/fragment_result_graded">

        <argument
            android:name="screeningId"
            app:argType="string" />

        <action
            android:id="@+id/action_resultGraded_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/patientHistoryFragment"
        android:name="com.veyronix.drishti.ui.history.PatientHistoryFragment"
        android:label="Patient History"
        tools:layout="@layout/fragment_patient_history">

        <argument
            android:name="patientId"
            app:argType="string" />

        <action
            android:id="@+id/action_history_to_capture"
            app:destination="@id/captureFragment" />
        <action
            android:id="@+id/action_history_to_resultGraded"
            app:destination="@id/resultGradedFragment" />
    </fragment>

    <fragment
        android:id="@+id/syncQueueFragment"
        android:name="com.veyronix.drishti.ui.sync.SyncQueueFragment"
        android:label="Sync Status"
        tools:layout="@layout/fragment_sync_queue" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.veyronix.drishti.ui.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings">

        <action
            android:id="@+id/action_settings_to_login"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

</navigation>
